# ============================================================
# COPY THIS FILE TO ".env" AND FILL IN YOUR OWN VALUES.
# NEVER SHARE YOUR .env FILE OR COMMIT IT TO GITHUB.
# ============================================================

# --- Telegram (required to receive alerts) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- AI provider (optional) ---
# Leave AI_PROVIDER empty to run with rule-based analysis only (still fully functional).
# Supported values: none, gemini, ollama
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Data source ---
# mock = demo dataset | listam = live List.am Yerevan listings
DATA_SOURCE=mock
LISTAM_MAX_PAGES=2
LISTAM_REQUEST_DELAY_SEC=0.5
LISTAM_LANGUAGE=en

# --- Filters ---
CITY=Yerevan
PROPERTY_TYPES=apartment,house
MIN_AREA_SQM=50
MAX_PRICE_USD=300000
MIN_ROOMS=2
MIN_DISCOUNT_PERCENT=10
MIN_DEAL_SCORE=70

# --- AI trigger threshold (only listings this far below market get AI analysis) ---
AI_TRIGGER_DISCOUNT_PERCENT=10

# --- Scheduling ---
CHECK_INTERVAL_MINUTES=5

# --- Currency ---
EXCHANGE_RATE_CACHE_HOURS=6
BASE_CURRENCY=USD

# --- Modes ---
DRY_RUN=false
DAILY_SUMMARY_ENABLED=true

# --- Database ---
DATABASE_PATH=data/listings.db
